{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window and backend sidecar",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/lih-backend",
          "sidecar": true
        }
      ]
    }
  ]
}
